# ── Opcional: sin estas variables la app usa almacenamiento en memoria ──

# Supabase local (supabase start) o cloud
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Server-only: service_role key (local CLI output o Supabase Dashboard)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin panel password (change in production)
ADMIN_PASSWORD=fachada-admin-dev

# Preview deploy only: show SMS codes in API/UI without Supabase (no real SMS)
# EXPOSE_DEV_SMS_CODE=true
