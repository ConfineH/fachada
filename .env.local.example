# ── Persistencia: sin estas variables la app usa MemoryStore ──

# Proyecto cloud Fachada (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://embmicoogxrxsvchywis.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=  # opcional; las tablas tienen RLS revoke y el server usa service_role

# Server-only. Dashboard → API → service_role. Nunca la subas a git.
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel password (cambia en producción)
ADMIN_PASSWORD=fachada-admin-dev

# Twilio — obligatorio en Vercel Production para SMS real.
# Local: si faltan, se usa mock y el código aparece en pantalla.
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+34...   # o número US de Twilio en formato E.164

# Preview deploy only: ignored when Twilio is configured or NODE_ENV=production
# EXPOSE_DEV_SMS_CODE=true

# Public site URL (la extensión Idealista puede override via localStorage)
# NEXT_PUBLIC_SITE_URL=https://fachada-tau.vercel.app

# Google Sign-In (OAuth client ID, authorized JS origins: localhost + dominio)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Resend — códigos al email en producción. Local: sin clave, el código sale en pantalla.
# RESEND_API_KEY=
# EMAIL_FROM=Fachada <noreply@tu-dominio.com>
